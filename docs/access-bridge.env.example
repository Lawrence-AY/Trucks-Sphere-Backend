# Merge into the Render backend environment. Do not expose this key to the web client.
TARTIM_ENABLED=false
TARTIM_SOURCE_ID=Tunaylar-WinScale
TARTIM_API_KEY=
TARTIM_UTC_OFFSET=+03:00
TARTIM_POLL_MS=3000
# loading: empty first, loaded second; input and tickets are always kg.
# unloading: legacy site receipt workflow; source/site weight unit applies.
TARTIM_WEIGHING_MODE=loading
TARTIM_SOURCE_WEIGHT_UNIT=kg
TARTIM_DRIVER_FIELD=DIGER3_ISIM
TARTIM_PO_FIELD=DIGER5_ISIM

# Merge into the main backend .env. Site and scale unit come from TruckSphere.
TARTIM_ENABLED=false
TARTIM_SOURCE_ID=TruckSphere-Listener
TARTIM_API_KEY=
TARTIM_UTC_OFFSET=+03:00
TARTIM_POLL_MS=3000
# Optional explicit Access scale unit: kg or tonnes; otherwise use site configuration.
TARTIM_SOURCE_WEIGHT_UNIT=
# Verified manual-kit columns: driver name/ID and optional exact PO number/ID.
TARTIM_DRIVER_FIELD=DIGER3_ISIM
TARTIM_PO_FIELD=DIGER5_ISIM

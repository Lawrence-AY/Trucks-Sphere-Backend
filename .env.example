NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trucksphere
DB_USER=postgres
DB_PASSWORD=postgres
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/trucksphere

# Set true for local schema creation after PostgreSQL is running.
DB_SYNC=false
DB_SYNC_ALTER=true
DB_SEED=true

# Auth
JWT_SECRET=replace_with_a_long_random_access_token_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_token_secret
REFRESH_EXPIRES_IN=7d
SEED_ADMIN_PASSWORD=password

# Operations
DEFAULT_WEIGHT_TOLERANCE=0.5
PUBLIC_LINK_SECRET=replace_with_a_long_random_public_link_secret

# Legacy Firebase, optional
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\firebase-service-account.json

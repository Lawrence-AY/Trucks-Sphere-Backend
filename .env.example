# Required cryptographic material. Generate independent values with a CSPRNG
# and provision them through your deployment secret manager; never commit .env.
ENCRYPTION_SECRET=REPLACE_WITH_A_64_CHARACTER_OR_LONGER_RANDOM_SECRET
ENCRYPTION_SALT=REPLACE_WITH_A_32_CHARACTER_OR_LONGER_RANDOM_SALT

# Firebase Web API key used by the server-side Identity Toolkit calls.
FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY

# Optional hardening configuration.
NODE_ENV=production
REFRESH_TOKEN_TTL_DAYS=30
SECURITY_CONTACT=mailto:security@trucksphere.app
SECURITY_POLICY_URL=https://trucksphere.app/security

# Odoo JSON-2 Purchase integration. Store the real key only in .env or your
# deployment secret manager; it must never be bundled into the mobile app.
ODOO_ENABLED=false
ODOO_BASE_URL=https://your-company.odoo.com
ODOO_DATABASE=your-company
ODOO_API_KEY=REPLACE_WITH_ODOO_API_KEY
